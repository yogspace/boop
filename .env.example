# Copy to .env (never committed). On the server the deploy writes it from the
# repository's secrets, same names (see README → Secrets).

# ── App ──────────────────────────────────────────────────────────────────────
# Public address, no trailing slash – links in mails (verification, password
# reset, report).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Random secret for logins (admin and accounts, at least 32 characters):
#   openssl rand -hex 32
PAYLOAD_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Local: the MongoDB from docker-compose.dev.yml (`make up-db`). On the server
# docker-compose.yml sets it itself (mongodb://mongo:27017/boop).
DATABASE_URL=mongodb://localhost:27019/boop

# ── First admin ──────────────────────────────────────────────────────────────
# Created at start as long as there is no admin (features/admin/seed-admin.ts)
# – otherwise /admin offers “create first user” to whoever comes first. Can
# go once the admin exists.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Resend (HTTPS – the server blocks SMTP). Without these, mails (verification,
# password reset, report) are only written to the console.
RESEND_API_KEY=
# Sender on a domain verified at Resend, e.g. Boop <hello@example.com>
MAIL_FROM=

# ── Mail report (optional) ───────────────────────────────────────────────────
# The cron route /next/cron/stats-digest is only allowed with this secret
# (or a logged-in admin):  openssl rand -hex 32
CRON_SECRET=
# Who gets the report.
MAIL_STATS_RECIPIENT=
