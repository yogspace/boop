# Copy to .env (never committed). On the server the deploy writes it from the
# repository's variables (public values) and secrets – same names (see README
# → Deploy).

# ── App ──────────────────────────────────────────────────────────────────────
# Public address, no trailing slash – links in mails (verification, password
# reset, report).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: Google Search Console's HTML-tag check (only the content value).
# Baked in at build time – a repository variable for the deploy.
GOOGLE_SITE_VERIFICATION=

# Optional, locally: 1 = register the service worker in `pnpm dev` too, to try
# the app offline. Off by default – a cached page would hide changes.
NEXT_PUBLIC_SW_DEV=

# Random secret for logins (admin and accounts, at least 32 characters):
#   openssl rand -hex 32
PAYLOAD_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Local: the MongoDB from docker-compose.dev.yml (`make up-db`). On the server
# docker-compose.yml sets it itself (mongodb://mongo:27017/boop).
DATABASE_URL=mongodb://localhost:27019/boop

# ── First admin ──────────────────────────────────────────────────────────────
# Created at start as long as there is no admin (features/admin/seed-admin.ts)
# – otherwise /admin offers “create first user” to whoever comes first. Can
# go once the admin exists.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Support mode – leave empty. 1 = admins may READ people's calendars, stamps,
# prints, notes, invitations and notification devices in /admin (a band on
# every page says so), e.g. to find a bug or answer a request for someone's
# data. Never in the deploy's secrets: set by hand in the server's .env, and
# the next deploy writes the .env anew without it (README → Access).
ADMIN_SUPPORT=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Resend (HTTPS – the server blocks SMTP). Without these, mails (verification,
# password reset, report) are only written to the console.
RESEND_API_KEY=
# Sender on a domain verified at Resend, e.g. Boop <hello@example.com>
MAIL_FROM=

# ── Mail report and cleanup ──────────────────────────────────────────────────
# The cron routes /next/cron/stats-digest (the report) and /next/cron/cleanup
# (expired invitations, unconfirmed sign-ups, unused accounts) are only
# allowed with this secret (or a logged-in admin):  openssl rand -hex 32
# The cleanup warns unused accounts by mail before deleting them – without
# RESEND_API_KEY nobody is warned, and so nobody deleted for being unused.
CRON_SECRET=
# Who gets the report.
MAIL_STATS_RECIPIENT=

# ── Notifications (Web Push) ─────────────────────────────────────────────────
# Optional. Without both keys notifications are off: the app doesn't offer
# them, nothing is sent. Made once – and kept: new keys silence every device
# that subscribed with the old ones.
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Whom the push services may contact about our messages: mailto:… or https://…
# – optional, NEXT_PUBLIC_SERVER_URL otherwise.
VAPID_SUBJECT=

# ── Contact form (imprint) ───────────────────────────────────────────────────
# Where the contact form's messages go (/next/contact). Never shown on the site.
MAIL_CONTACT_RECIPIENT=
