{
  "name": "boop",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "node scripts/prepare.mjs && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "build": "node scripts/prepare.mjs && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "graphql": "^16.14.2",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.181.2",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.181.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "undici@<7.29.1": "^7.29.1",
      "dompurify@<3.4.16": "^3.4.16"
    }
  }
}
